# Google Ads — from Tools > Conversions > (your conversion) > Tag setup
VITE_GADS_ID=AW-XXXXXXXXXX
VITE_GADS_LEAD_LABEL=xxxxxxxxxxxxxxxxxxxx
VITE_GADS_CALL_LABEL=
# Optional GA4
VITE_GA4_ID=

# Server-side only (set in Vercel project settings, never prefixed with VITE_)
# Where each lead is POSTed as JSON: Google Apps Script web app, Zapier/Make hook, GHL inbound webhook, your AI responder...
LEAD_WEBHOOK_URL=
# Optional second destination (e.g. backup sheet)
LEAD_WEBHOOK_URL_2=
# Optional shared secret sent as X-Lead-Secret so your webhook can reject junk
LEAD_WEBHOOK_SECRET=

# Twilio auto-text sent right after a lead opts in (leave blank to skip). From console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number (+1904...) or Messaging Service SID (MG...) tied to your A2P 10DLC campaign
TWILIO_FROM=
